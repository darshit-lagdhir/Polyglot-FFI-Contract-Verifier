# Root files
include README.md
include LICENSE
include CHANGELOG.md
include RELEASE_NOTES.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include pyproject.toml
include setup.py
include pytest.ini
include .pfcv_version

# Documentation
recursive-include docs *.md *.png *.jpg *.gif *.svg
recursive-include modules *.md

# Examples
recursive-include examples *.py *.h *.c *.cpp *.md *.json *.yaml

# Core Implementation
recursive-include modules *.py *.typed

# Tests
recursive-include tests *.py

# Exclude compiled artifacts and metadata
global-exclude *.py[cod] __pycache__ *.so *.dylib *.dll
global-exclude .DS_Store .git .pytest_cache .coverage
global-exclude *.egg-info
